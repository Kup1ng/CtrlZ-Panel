{
  "format": 1,
  "group": "identity",
  "cases": [
    {"id": "id-host-001", "why": "The zone apex", "op": "parse_host", "input": "dns.example.com", "args": ["dns.example.com"], "expect": "apex"},
    {"id": "id-host-002", "why": "Case and one trailing dot are ignored", "op": "parse_host", "input": "DNS.Example.COM.", "args": ["dns.example.com"], "expect": "apex"},
    {"id": "id-host-003", "why": "A different domain is out of the zone", "op": "parse_host", "input": "example.org", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-host-004", "why": "A name that only ends with the zone text is not below it", "op": "parse_host", "input": "evildns.example.com", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-host-005", "why": "DoT SNI: a bare resolver id (26 bytes)", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2.dns.example.com", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client="},
    {"id": "id-host-006", "why": "DoQ SNI: id and client label", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-kid.dns.example.com", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client=kid"},
    {"id": "id-host-007", "why": "DoH :authority: the port is stripped", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-kid.dns.example.com:443", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client=kid"},
    {"id": "id-host-007b", "why": "An FQDN authority with a port: port first, then one dot (review L1-F11)", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-kid.dns.example.com.:443", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client=kid"},
    {"id": "id-host-007c", "why": "The apex as an FQDN with a port", "op": "parse_host", "input": "dns.example.com.:443", "args": ["dns.example.com"], "expect": "apex"},
    {"id": "id-host-007d", "why": "A dot after the port is not an FQDN dot", "op": "parse_host", "input": "dns.example.com:443.", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-host-008", "why": "A 36-byte client label is the longest allowed", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.dns.example.com", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {"id": "id-host-009", "why": "A 37-byte client label is malformed", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-010", "why": "25 bytes: one short of a resolver id", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-011", "why": "27 bytes without a hyphen at position 26", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2x.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-012", "why": "A trailing hyphen leaves an empty client label", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-013", "why": "A client label may not start with a hyphen", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2--a.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-014", "why": "Extra labels below the resolver label", "op": "parse_host", "input": "a.abcdefghijklmnopqrstuvwxy2.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-015", "why": "The digit 1 is not in the base32 alphabet", "op": "parse_host", "input": "1bcdefghijklmnopqrstuvwxy2.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-016", "why": "A verify label below .verify", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2.verify.dns.example.com", "args": ["dns.example.com"], "expect": "verify label=abcdefghijklmnopqrstuvwxy2"},
    {"id": "id-host-017", "why": "The bare verify name is reserved", "op": "parse_host", "input": "verify.dns.example.com", "args": ["dns.example.com"], "expect": "reserved name=verify"},
    {"id": "id-host-018", "why": "myip is reserved", "op": "parse_host", "input": "myip.dns.example.com", "args": ["dns.example.com"], "expect": "reserved name=myip"},
    {"id": "id-host-019", "why": "ACME challenge name is reserved", "op": "parse_host", "input": "_acme-challenge.dns.example.com", "args": ["dns.example.com"], "expect": "reserved name=_acme-challenge"},
    {"id": "id-host-020", "why": "ns1 to ns4 are reserved", "op": "parse_host", "input": "ns4.dns.example.com", "args": ["dns.example.com"], "expect": "reserved name=ns4"},
    {"id": "id-host-021", "why": "ns5 is not", "op": "parse_host", "input": "ns5.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-022", "why": "A short label under .verify is malformed", "op": "parse_host", "input": "short.verify.dns.example.com", "args": ["dns.example.com"], "expect": "malformed"},
    {"id": "id-host-023", "why": "During a domain change either zone resolves", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2.dns.old.example", "args": ["dns.new.example", "dns.old.example"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client="},
    {"id": "id-host-024", "why": "Missing SNI is the empty host: out of zone, and the handshake still completes", "op": "parse_host", "input": "", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-host-025", "why": "_acme-challenge.verify is reserved: the DNS-01 name of the *.verify SAN (SC 3 step 5)", "op": "parse_host", "input": "_acme-challenge.verify.dns.example.com", "args": ["dns.example.com"], "expect": "reserved name=_acme-challenge.verify"},

    {"id": "id-doh-001", "why": "Form A: token only, resolver id comes from :authority", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567", "expect": "form=A rid= token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-doh-002", "why": "Form A with a client", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567/kid", "expect": "form=A rid= token=abcdefghijklmnopqrstuvwxyz234567 client=kid"},
    {"id": "id-doh-003", "why": "The query string is ignored", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567?dns=AAABAAAB", "expect": "form=A rid= token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-doh-004", "why": "Segments are lowercased", "op": "parse_doh_path", "input": "/ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", "expect": "form=A rid= token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-doh-005", "why": "Form B: id then token", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567", "expect": "form=B rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-doh-006", "why": "Form B with a client", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567/kid-1", "expect": "form=B rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client=kid-1"},
    {"id": "id-doh-007", "why": "The classic /dns-query path is not ours", "op": "parse_doh_path", "input": "/dns-query", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-008", "why": "Root path", "op": "parse_doh_path", "input": "/", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-009", "why": "No leading slash", "op": "parse_doh_path", "input": "abcdefghijklmnopqrstuvwxyz234567", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-010", "why": "A trailing slash is an empty client segment", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567/", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-011", "why": "Extra segments", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567/a/b", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-012", "why": "A 31-byte first segment fits neither form", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz23456", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-013", "why": "Form B with a short token", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxy2/short", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-014", "why": "Form B with one segment only", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxy2", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-015", "why": "A client label that starts with a hyphen", "op": "parse_doh_path", "input": "/abcdefghijklmnopqrstuvwxyz234567/-bad", "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-doh-016", "why": "Percent-encoded dots are not decoded here", "op": "parse_doh_path", "input": "/%2e%2e/abcdefghijklmnopqrstuvwxyz234567", "error": true, "error_contains": "identity: unrecognized path"},

    {"id": "id-res-001", "why": "Form A takes the id and client from :authority", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxyz234567", "args": ["abcdefghijklmnopqrstuvwxy2-dev.dns.example.com:443", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client=dev"},
    {"id": "id-res-002", "why": "Form A with an apex :authority has no id: refused", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxyz234567", "args": ["dns.example.com", "dns.example.com"], "error": true, "error_contains": "identity: unrecognized path"},
    {"id": "id-res-003", "why": "Form B works from the apex", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567", "args": ["dns.example.com", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-res-004", "why": "The path client beats the :authority client", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxyz234567/pathc", "args": ["abcdefghijklmnopqrstuvwxy2-authc.dns.example.com", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client=pathc"},
    {"id": "id-res-005", "why": "Path over :authority: in form B the path's id wins and another resolver's host contributes nothing, not even its client", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567", "args": ["zyxwvutsrqponmlkjihgfedcba-evil.dns.example.com", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-res-006", "why": "Form A with an authority outside the zone", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxyz234567", "args": ["example.org", "dns.example.com"], "error": true, "error_contains": "identity: unrecognized path"},

    {"id": "id-slug-001", "why": "Spaces and case", "op": "slug_client", "input": "My Phone", "expect": "my-phone"},
    {"id": "id-slug-002", "why": "Runs of punctuation become one hyphen, edges are trimmed", "op": "slug_client", "input": "  --Kid's iPad", "expect": "kid-s-ipad"},
    {"id": "id-slug-003", "why": "NFKC folds full-width forms", "op": "slug_client", "input": "ＡＢＣ１２３", "expect": "abc123"},
    {"id": "id-slug-004", "why": "Persian text leaves nothing: the wizard must ask for a label", "op": "slug_client", "input": "گوشی من", "error": true, "error_contains": "nothing left"},
    {"id": "id-slug-005", "why": "Only punctuation", "op": "slug_client", "input": "---", "error": true, "error_contains": "nothing left"},
    {"id": "id-slug-006", "why": "Cut to 36 bytes", "op": "slug_client", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {"id": "id-slug-007", "why": "A hyphen exposed by the cut is trimmed again", "op": "slug_client", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa b", "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},

    {"id": "id-tok-001", "why": "The right token matches its stored hash", "op": "token_check", "input": "abcdefghijklmnopqrstuvwxyz234567", "args": ["6bf28d79c3592be131e9a3863111b1cd14dbc2d7da255cf885d4651dc5a56b62"], "expect": "match"},
    {"id": "id-tok-002", "why": "Wrong token: one character different", "op": "token_check", "input": "abcdefghijklmnopqrstuvwxyz234568", "args": ["6bf28d79c3592be131e9a3863111b1cd14dbc2d7da255cf885d4651dc5a56b62"], "expect": "mismatch"},
    {"id": "id-tok-003", "why": "Wrong token: upper case is a different token, not a folded one", "op": "token_check", "input": "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", "args": ["6bf28d79c3592be131e9a3863111b1cd14dbc2d7da255cf885d4651dc5a56b62"], "expect": "mismatch"},
    {"id": "id-tok-004", "why": "Wrong token: empty", "op": "token_check", "input": "", "args": ["6bf28d79c3592be131e9a3863111b1cd14dbc2d7da255cf885d4651dc5a56b62"], "expect": "mismatch"},
    {"id": "id-tok-005", "why": "Wrong token: the right token with a suffix", "op": "token_check", "input": "abcdefghijklmnopqrstuvwxyz234567a", "args": ["6bf28d79c3592be131e9a3863111b1cd14dbc2d7da255cf885d4651dc5a56b62"], "expect": "mismatch"},

    {"id": "id-sni-001", "why": "SNI is ignored for DoH: a form B stream whose :authority is outside the zone still resolves by its own path, whatever the connection's SNI was", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567", "args": ["other.example.org", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client="},
    {"id": "id-sni-002", "why": "SNI is ignored for DoH: a resolver-looking :authority with another id cannot select the Endpoint, because ResolveDoH takes no SNI and the path wins", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxy2/abcdefghijklmnopqrstuvwxyz234567", "args": ["zyxwvutsrqponmlkjihgfedcba.dns.example.com", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client="},

    {"id": "id-proto-001", "why": "UDP carries no name: the host is empty, so identity can only come from the source IP (ip_claims)", "op": "parse_host", "input": "", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-proto-002", "why": "TCP port 53 is the same: no name, source IP identity", "op": "parse_host", "input": "", "args": ["dns.example.com"], "expect": "out_of_zone"},
    {"id": "id-proto-003", "why": "DoT identity is the SNI: id and client label", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2-kid.dns.example.com", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client=kid"},
    {"id": "id-proto-004", "why": "DoQ identity is the SNI too, with the same grammar", "op": "parse_host", "input": "abcdefghijklmnopqrstuvwxy2.dns.example.com", "args": ["dns.example.com"], "expect": "resolver rid=abcdefghijklmnopqrstuvwxy2 client="},
    {"id": "id-proto-005", "why": "DoH identity is the stream's path and :authority, never the SNI", "op": "resolve_doh", "input": "/abcdefghijklmnopqrstuvwxyz234567", "args": ["abcdefghijklmnopqrstuvwxy2-dev.dns.example.com:443", "dns.example.com"], "expect": "rid=abcdefghijklmnopqrstuvwxy2 token=abcdefghijklmnopqrstuvwxyz234567 client=dev"}
  ]
}
