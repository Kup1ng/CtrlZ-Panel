{
  "format": 1,
  "group": "route",
  "cases": [
    {"id": "route-001", "why": "domain: exact name only", "op": "route_match", "input": "exact.example.com/A",
     "args": ["1|domain|exact.example.com|g-domain", "9|||g-default|final"], "expect": "g-domain"},
    {"id": "route-002", "why": "domain does not match a subdomain, so the final default takes it", "op": "route_match", "input": "sub.exact.example.com/A",
     "args": ["1|domain|exact.example.com|g-domain", "9|||g-default|final"], "expect": "g-default"},
    {"id": "route-003", "why": "suffix: the name and anything below", "op": "route_match", "input": "a.b.example.ir/A",
     "args": ["1|suffix|example.ir|g-suffix", "9|||g-default|final"], "expect": "g-suffix"},
    {"id": "route-004", "why": "suffix matches the name itself", "op": "route_match", "input": "example.ir/A",
     "args": ["1|suffix|example.ir|g-suffix", "9|||g-default|final"], "expect": "g-suffix"},
    {"id": "route-005", "why": "suffix does not match a name that merely ends with the same text", "op": "route_match", "input": "notexample.ir/A",
     "args": ["1|suffix|example.ir|g-suffix", "9|||g-default|final"], "expect": "g-default"},
    {"id": "route-006", "why": "geosite: membership in a catalog set", "op": "route_match", "input": "digikala.example/A",
     "args": ["G|geosite:ir|digikala.example,aparat.example", "1|geosite|geosite:ir|g-geo", "9|||g-default|final"], "expect": "g-geo"},
    {"id": "route-007", "why": "geosite: not a member", "op": "route_match", "input": "other.example/A",
     "args": ["G|geosite:ir|digikala.example", "1|geosite|geosite:ir|g-geo", "9|||g-default|final"], "expect": "g-default"},
    {"id": "route-008", "why": "qtype by mnemonic", "op": "route_match", "input": "mail.other.com/MX",
     "args": ["1|qtype|MX|g-mx", "9|||g-default|final"], "expect": "g-mx"},
    {"id": "route-009", "why": "qtype by number (28 is AAAA)", "op": "route_match", "input": "host.other.com/AAAA",
     "args": ["1|qtype|28|g-v6", "9|||g-default|final"], "expect": "g-v6"},
    {"id": "route-010", "why": "tld: the last label", "op": "route_match", "input": "site.other.ir/A",
     "args": ["1|tld|ir|g-tld", "9|||g-default|final"], "expect": "g-tld"},
    {"id": "route-011", "why": "Order decides, not list position: the lower order wins", "op": "route_match", "input": "a.example.com/A",
     "args": ["20|suffix|example.com|late", "10|suffix|example.com|early"], "expect": "early"},
    {"id": "route-012", "why": "No rule and no final default: none, so the node uses its default mode", "op": "route_match", "input": "x.example.com/A",
     "args": ["1|domain|other.example.com|g"], "expect": "none"},
    {"id": "route-013", "why": "First match ends the search even if a later rule also matches", "op": "route_match", "input": "x.example.ir/A",
     "args": ["1|tld|ir|g-tld", "2|suffix|example.ir|g-suffix"], "expect": "g-tld"},
    {"id": "route-020", "why": "An IP literal is not a domain rule", "op": "route_match", "input": "x.example.com/A", "args": ["1|domain|1.2.3.4|g"], "error": true, "error_contains": "route: bad match_value"},
    {"id": "route-021", "why": "Unknown match type", "op": "route_match", "input": "x.example.com/A", "args": ["1|regex|x|g"], "error": true, "error_contains": "route: unknown match_type"},
    {"id": "route-022", "why": "geosite without the geosite: prefix", "op": "route_match", "input": "x.example.com/A", "args": ["1|geosite|ir|g"], "error": true, "error_contains": "route: bad match_value"},
    {"id": "route-023", "why": "A rule must name a group", "op": "route_match", "input": "x.example.com/A", "args": ["1|domain|x.example.com|"], "error": true, "error_contains": "route: a rule needs a group"},
    {"id": "route-024", "why": "tld takes exactly one label", "op": "route_match", "input": "x.example.com/A", "args": ["1|tld|a.b|g"], "error": true, "error_contains": "route: bad match_value"}
  ]
}
