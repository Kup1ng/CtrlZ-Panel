{
  "format": 1,
  "group": "grants",
  "cases": [
    {"id": "g-001", "why": "Put: a source that is not validated writes nothing and replaces nothing; it gets ok only for a holder that is live with an equal outcome and at least MaxProxyTTL of life (4.2 step 2)",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "plain": true, "d": {"kind": 1, "loc": 2}, "expect": "validate"},
       {"op": "state", "expect": "-"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "put", "t": 100, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "plain": true, "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 11000, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "plain": true, "d": {"kind": 1, "loc": 2}, "expect": "validate"},
       {"op": "put", "t": 11000, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "plain": true, "d": {"kind": 1, "loc": 3}, "expect": "validate"},
       {"op": "put", "t": 11000, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "plain": true, "d": {"kind": 1, "loc": 2}, "expect": "validate"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A"}
     ]},
    {"id": "g-002", "why": "Join: two tenants that redirect one name to one location both hold it, and the end of A's Grant leaves B's",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A,B"},
       {"op": "end", "cause": "hard_disabled", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=B"}
     ]},
    {"id": "g-003", "why": "Refuse: a second tenant that redirects the name to another location is refused, and A's Grant stands",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A"}
     ]},
    {"id": "g-004", "why": "Pick: an Auto or Random decision joins a live location that lies in the set it drew from, and not one outside it; the live outcome does not change",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "pick": "auto", "loc": 1, "eff": [1, 2, 3]}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "C", "acct": "c", "d": {"kind": 1, "pick": "random", "loc": 1, "eff": [1, 3]}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A,B"}
     ]},
    {"id": "g-005", "why": "Pick: a fixed decision does not join through a set; it must name the live location itself",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "pick": "auto", "loc": 1, "eff": [1, 2]}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 1}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=1 holders=A,B"}
     ]},
    {"id": "g-006", "why": "Branded: the same page joins, another page is refused, and so is a Redirect on a blocked name",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 2, "page": "p1"}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 2, "page": "p1"}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "C", "acct": "c", "d": {"kind": 2, "page": "p2"}, "expect": "refused:collision"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "D", "acct": "d", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=2 page=p1 holders=A,B"}
     ]},
    {"id": "g-007", "why": "A different dial host (Safe Search) does not join, and the same one does",
     "steps": [
       {"op": "put", "t": 0, "name": "www.g.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "dial": "safe.g.test"}, "expect": "ok"},
       {"op": "put", "name": "www.g.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "put", "name": "www.g.test", "src": "192.0.2.10", "ep": "C", "acct": "c", "d": {"kind": 1, "loc": 2, "dial": "safe.g.test"}, "expect": "ok"},
       {"op": "state", "expect": "www.g.test 192.0.2.10 kind=1 loc=2 dial=safe.g.test holders=A,C"}
     ]},
    {"id": "g-008", "why": "Two clients of one Endpoint behind one address, the parent with a Redirect and the child with Branded: the second never changes the first's outcome, in both orders",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 10, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "kid", "d": {"kind": 2, "page": "p"}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E"},
       {"op": "put", "t": 0, "name": "y.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "kid", "d": {"kind": 2, "page": "p"}, "expect": "ok"},
       {"op": "put", "t": 10, "name": "y.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E ; y.test 192.0.2.10 kind=2 page=p holders=E/kid"}
     ]},
    {"id": "g-009", "why": "Leave: the device that was silent for MaxProxyTTL leaves with the one that decides, because no cache holds an answer of it, and the new outcome is written",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 3599, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "kid", "d": {"kind": 2, "page": "p"}, "expect": "refused:collision"},
       {"op": "put", "t": 3600, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "kid", "d": {"kind": 2, "page": "p"}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=2 page=p holders=E/kid"}
     ]},
    {"id": "g-010", "why": "Replace: after an edit from one location to another, with two Endpoints of one tenant: the first to decide gets Bypass, the second writes the new location, the first's next query joins it, and the open connection stays",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "E1", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 1, "name": "x.test", "src": "192.0.2.10", "ep": "E2", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "charged:a/E2"},
       {"op": "put", "t": 20, "name": "x.test", "src": "192.0.2.10", "ep": "E1", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E2 | conns c1:a/E2"},
       {"op": "put", "t": 21, "name": "x.test", "src": "192.0.2.10", "ep": "E2", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "ok"},
       {"op": "put", "t": 22, "name": "x.test", "src": "192.0.2.10", "ep": "E1", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=3 holders=E1,E2 | conns c1:a/E2"}
     ]},
    {"id": "g-011", "why": "No put removes a holder of another account: A's new decision cannot take B's holder out",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 10000, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=B"},
       {"op": "put", "t": 14400, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "ok"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=3 holders=A"}
     ]},
    {"id": "g-012", "why": "Cross: B decided on node 2 and forwarded; A's holder on node 1 stands, B's forward is refused there, and nothing of A's changes",
     "steps": [
       {"op": "put", "t": 0, "node": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 3}, "expect": "ok"},
       {"op": "put", "node": "n1", "origin": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "put", "node": "n2", "origin": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "sent", "node": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "A", "result": "refused"},
       {"op": "sent", "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "B", "result": "refused"},
       {"op": "state", "node": "n1", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A!alone"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=3 holders=B!alone"}
     ]},
    {"id": "g-013", "why": "A forwarded holder is written when the receiver would decide the same. Another account's local decision does not take it over, but the same device's own newer decision (same Endpoint and client, another origin) does: after an edit the device must not stay on Bypass here until the copy expires (B1-r1-11)",
     "steps": [
       {"op": "put", "t": 0, "node": "n2", "origin": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E@n1"},
       {"op": "put", "t": 5, "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E@n1"},
       {"op": "put", "t": 6, "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "ok"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=3 holders=E,E@n1"},
       {"op": "put", "t": 7, "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "ok"}
     ]},
    {"id": "g-037", "why": "The device's own forwarded copy leaves with its newer decision when another account holds the entry: the holders of this (Endpoint, client) leave whatever their origin, and the other account's holder stays (B1-r1-11)",
     "steps": [
       {"op": "put", "t": 0, "node": "n2", "origin": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 1, "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "C", "acct": "c", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 2, "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 3}, "expect": "refused:collision"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=C"}
     ]},
    {"id": "g-014", "why": "A forwarded Put is validated by its sender: it needs no cookie here (T-053)",
     "steps": [
       {"op": "put", "t": 0, "node": "n2", "origin": "n1", "plain": true, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=E@n1"}
     ]},
    {"id": "g-015", "why": "Cap: one (Endpoint, source) uses a quarter of the Endpoint's cap, and another source is served",
     "limits": {"grant_cap": 16},
     "steps": [
       {"op": "put", "t": 0, "name": "a.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "b.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "c.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "d.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "e.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "refused:endpoint_cap"},
       {"op": "put", "name": "e.test", "src": "192.0.2.11", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"}
     ]},
    {"id": "g-016", "why": "Cap: the last quarter of an Endpoint's cap is for a source in a claim or an authorized prefix alone, and a refresh needs no room",
     "limits": {"grant_cap": 16},
     "steps": [
       {"op": "put", "t": 0, "name": "a1.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a2.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a3.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a4.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "b1.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "b2.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "b3.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "b4.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "c1.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "c2.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "c3.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "c4.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "d1.test", "src": "192.0.2.4", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "refused:endpoint_cap"},
       {"op": "put", "name": "d1.test", "src": "192.0.2.4", "ep": "E", "acct": "a", "claim": true, "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a1.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"}
     ]},
    {"id": "g-017", "why": "Cap: forwarded holders use at most half of an Endpoint's cap, and the Endpoint's cap counts both kinds",
     "limits": {"grant_cap": 16},
     "steps": [
       {"op": "put", "t": 0, "origin": "n1", "name": "a1.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "a2.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "a3.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "a4.test", "src": "192.0.2.1", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "b1.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "b2.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "b3.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "b4.test", "src": "192.0.2.2", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "origin": "n1", "name": "c1.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "refused:endpoint_cap"},
       {"op": "put", "name": "c1.test", "src": "192.0.2.3", "ep": "E", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"}
     ]},
    {"id": "g-018", "why": "Cap: the node's cap under the share rule: an account gets one more only while it holds less than an eighth of the free room, so another account is still served",
     "limits": {"node_cap": 40},
     "steps": [
       {"op": "put", "t": 0, "name": "a1.test", "src": "192.0.2.1", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a2.test", "src": "192.0.2.1", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a3.test", "src": "192.0.2.1", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a4.test", "src": "192.0.2.2", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "a5.test", "src": "192.0.2.2", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
