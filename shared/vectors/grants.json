       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A | conns c1:a/A"}
     ]},
    {"id": "g-032", "why": "End: a holder that a pair node forwarded ends with that node's entry: the node is revoked or leaves the pair (origin_removed)",
     "steps": [
       {"op": "put", "t": 0, "node": "n2", "origin": "n1", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "node": "n2", "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "node": "n2", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "charged:a/A"},
