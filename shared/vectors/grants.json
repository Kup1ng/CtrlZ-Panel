       {"op": "state", "node": "n2", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A | conns c1:a/A"}
     ]},
    {"id": "g-033", "why": "End: a name that became never-proxied ends the kind 1 holders of it, and a Branded block of the same name is untouched",
     "steps": [
       {"op": "put", "t": 0, "name": "x.ir", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
