    {"id": "g-019", "why": "Collision: an entry holds at most 8 holders of one Endpoint; one more is a collision",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c1", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c2", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c3", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c4", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c5", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c6", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c7", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c8", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c9", "d": {"kind": 1, "loc": 2}, "expect": "refused:collision"},
       {"op": "put", "t": 5, "name": "x.test", "src": "192.0.2.10", "ep": "E", "acct": "a", "client": "c1", "d": {"kind": 1, "loc": 2}, "expect": "ok"}
