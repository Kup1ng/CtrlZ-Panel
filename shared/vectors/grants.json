    {"id": "g-020", "why": "R9: a Redirect of a name that is not public to dial is refused as unsafe; a block page for it is not",
     "steps": [
       {"op": "put", "t": 0, "name": "intranet", "src": "192.0.2.10", "ep": "A", "acct": "a", "unsafe": true, "d": {"kind": 1, "loc": 2}, "expect": "refused:unsafe"},
       {"op": "put", "name": "intranet", "src": "192.0.2.10", "ep": "A", "acct": "a", "unsafe": true, "d": {"kind": 2, "page": "p"}, "expect": "ok"},
       {"op": "state", "expect": "intranet 192.0.2.10 kind=2 page=p holders=A"}
     ]},
    {"id": "g-021", "why": "Width: exact never widens; prefix24 widens within the /24 only; the widened source is no key",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "exact x.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "exact", "expect": "none"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "prefix24", "expect": "widened x.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "lookup", "name": "x.test", "src": "192.0.3.77", "width": "prefix24", "expect": "none"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A"}
     ]},
    {"id": "g-022", "why": "Width: two Endpoints in the /24 match neither, one Endpoint in two entries still matches (the test is on Endpoints and not on entries)",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.11", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "prefix24", "expect": "widened x.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "put", "name": "x.test", "src": "192.0.2.12", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "prefix24", "expect": "none"},
       {"op": "put", "name": "y.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "put", "name": "y.test", "src": "192.0.2.11", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 3, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "y.test", "src": "192.0.2.77", "width": "prefix24", "expect": "none"}
     ]},
    {"id": "g-023", "why": "Width: a wildcard rule match is never widened, and a holder that can be widened beside it does not make it so",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": false}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "prefix24", "expect": "none"},
       {"op": "put", "name": "y.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": false}, "expect": "ok"},
       {"op": "put", "name": "y.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "y.test", "src": "192.0.2.77", "width": "prefix24", "expect": "widened y.test 192.0.2.10 kind=1 loc=2 holders=A,B"}
     ]},
    {"id": "g-024", "why": "Width: carrier matches on a GeoIP ASN that is equal and not 0, and an ASN of 0 never matches",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "198.51.100.5", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "203.0.113.9", "width": "carrier", "asn": {"198.51.100.5": 64500, "203.0.113.9": 64500}, "expect": "widened x.test 198.51.100.5 kind=1 loc=2 holders=A"},
       {"op": "lookup", "name": "x.test", "src": "203.0.113.9", "width": "carrier", "asn": {"198.51.100.5": 64500, "203.0.113.9": 64501}, "expect": "none"},
       {"op": "lookup", "name": "x.test", "src": "203.0.113.9", "width": "carrier", "asn": {}, "expect": "none"},
       {"op": "lookup", "name": "x.test", "src": "203.0.113.9", "width": "carrier", "asn": {"198.51.100.5": 0, "203.0.113.9": 0}, "expect": "none"}
     ]},
    {"id": "g-025", "why": "Width: each lookup that is not an exact hit counts what every width would have said, per client ASN, with no name and no address",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.10", "width": "exact", "asn": {"192.0.2.10": 64500}, "expect": "exact x.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.77", "width": "exact", "asn": {"192.0.2.77": 64500, "192.0.2.10": 64500}, "expect": "none"},
       {"op": "lookup", "name": "x.test", "src": "198.51.100.1", "width": "exact", "asn": {"198.51.100.1": 64501}, "expect": "none"},
       {"op": "put", "name": "x.test", "src": "192.0.2.11", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2, "widenable": true}, "expect": "ok"},
       {"op": "lookup", "name": "x.test", "src": "192.0.2.78", "width": "exact", "asn": {"192.0.2.78": 64500, "192.0.2.10": 64500, "192.0.2.11": 64500}, "expect": "none"},
       {"op": "stats", "id": "0", "expect": "-"},
       {"op": "stats", "id": "64500", "expect": "exact=1 prefix24_unique=1 prefix24_shared=1 carrier_unique=1 carrier_shared=1"},
       {"op": "stats", "id": "64501", "expect": "miss=1"}
     ]},
    {"id": "g-026", "why": "Charge: a connection of an entry whose holders are of one account is charged to the Endpoint of the newest deciding query; the Endpoint's cap refuses the next",
     "limits": {"endpoint_conns": 1},
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "charged:a/A"},
       {"op": "open", "id": "c2", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "refused:endpoint_cap"},
       {"op": "open", "id": "c3", "name": "other.test", "src": "192.0.2.10", "width": "exact", "expect": "none"},
       {"op": "put", "t": 1, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c4", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "open", "id": "c5", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A,B | conns c1:a/A,c4:shared,c5:shared"}
     ]},
    {"id": "g-027", "why": "Charge: a shared connection counts against its entry and the shared part of the pool, and against no Endpoint's cap, so A alone cannot use up B's Endpoint",
     "limits": {"endpoint_conns": 1, "entry_conns": 2, "node_conns": 8},
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "open", "id": "c2", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "open", "id": "c3", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "open", "id": "c4", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "open", "id": "c5", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "refused:entry_cap"}
     ]},
    {"id": "g-028", "why": "End: hard_disabled of A closes none of a shared connection while B holds, and closes it once B ended; a connection charged to A alone closes with A",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "charged:a/A"},
       {"op": "put", "t": 1, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c2", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "end", "cause": "hard_disabled", "ep": "A", "expect": "closed=c1"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=B | conns c2:shared"},
       {"op": "end", "cause": "hard_disabled", "ep": "B", "expect": "closed=c2"},
       {"op": "state", "expect": "-"}
     ]},
    {"id": "g-029", "why": "End: nine Endpoints hold an entry, eight of A and one of B; when A's eight end, a connection that recorded only A's eight stays while B holds (the mark more)",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "B", "acct": "b", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 1, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c1", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 2, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c2", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 3, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c3", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 4, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c4", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 5, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c5", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 6, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c6", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 7, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c7", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "t": 8, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "client": "c8", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "shared"},
       {"op": "end", "cause": "hard_disabled", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=B | conns c1:shared"},
       {"op": "end", "cause": "hard_disabled", "ep": "B", "expect": "closed=c1"}
     ]},
    {"id": "g-030", "why": "End: the claim that made a holder is gone, an authorized prefix lost by an open holder with no claim, a revocation of kind endpoint and of kind claim: each ends what 4.6 names",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "claim": true, "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "y.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "open": true, "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "put", "name": "z.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "end", "cause": "authorized_lost", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "x.test 192.0.2.10 kind=1 loc=2 holders=A ; z.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "end", "cause": "claim_gone", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "z.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "put", "name": "w.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "claim": true, "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "end", "cause": "revocation_claim", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "z.test 192.0.2.10 kind=1 loc=2 holders=A"},
       {"op": "end", "cause": "revocation_endpoint", "ep": "A", "expect": "closed=-"},
       {"op": "state", "expect": "-"}
     ]},
    {"id": "g-031", "why": "End: soft_disabled, a policy edit and a lost prefix end nothing, neither a holder nor a connection",
     "steps": [
       {"op": "put", "t": 0, "name": "x.test", "src": "192.0.2.10", "ep": "A", "acct": "a", "d": {"kind": 1, "loc": 2}, "expect": "ok"},
       {"op": "open", "id": "c1", "name": "x.test", "src": "192.0.2.10", "width": "exact", "expect": "charged:a/A"},
       {"op": "end", "cause": "soft_disabled", "ep": "A", "expect": "closed=-"},
       {"op": "end", "cause": "policy_edit", "ep": "A", "expect": "closed=-"},
