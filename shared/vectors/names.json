{
  "format": 1,
  "group": "names",
  "cases": [
    {"id": "names-001", "why": "Case folding on user input", "op": "parse_user", "input": "Example.COM", "expect": "example.com"},
    {"id": "names-002", "why": "ASCII space is trimmed and one trailing dot stripped", "op": "parse_user", "input": " example.com. ", "expect": "example.com"},
    {"id": "names-003", "why": "IDNA: ü maps to Punycode", "op": "parse_user", "input": "münchen.de", "expect": "xn--mnchen-3ya.de"},
    {"id": "names-004", "why": "IDNA non-transitional: ß is kept, not mapped to ss", "op": "parse_user", "input": "faß.de", "expect": "xn--fa-hia.de"},
    {"id": "names-005", "why": "Underscore labels are legal (service names, DKIM)", "op": "parse_user", "input": "_dmarc.example.ir", "expect": "_dmarc.example.ir"},
    {"id": "names-006", "why": "A single-label name is a name", "op": "parse_user", "input": "ir", "expect": "ir"},
    {"id": "names-010", "why": "Empty input", "op": "parse_user", "input": "", "error": true, "error_contains": "names: empty input"},
    {"id": "names-011", "why": "The root is not a user name", "op": "parse_user", "input": ".", "error": true, "error_contains": "names: empty input"},
    {"id": "names-012", "why": "IPv4 literal", "op": "parse_user", "input": "1.2.3.4", "error": true, "error_contains": "names: IP literal is not a domain name"},
    {"id": "names-013", "why": "Bracketed IPv6 literal", "op": "parse_user", "input": "[::1]", "error": true, "error_contains": "names: IP literal is not a domain name"},
    {"id": "names-014", "why": "Bare IPv6 literal", "op": "parse_user", "input": "2001:db8::1", "error": true, "error_contains": "names: IP literal is not a domain name"},
    {"id": "names-015", "why": "Empty label", "op": "parse_user", "input": "a..b", "error": true, "error_contains": "names: empty label"},
    {"id": "names-016", "why": "Space inside a name", "op": "parse_user", "input": "exa mple.com", "error": true, "error_contains": "names: byte outside [a-z0-9_-] in label"},
    {"id": "names-017", "why": "A star is not a name byte (rules handle it before calling this)", "op": "parse_user", "input": "a*b.com", "error": true, "error_contains": "names: byte outside [a-z0-9_-] in label"},
    {"id": "names-018", "why": "Slash", "op": "parse_user", "input": "a/b.com", "error": true, "error_contains": "names: byte outside [a-z0-9_-] in label"},
    {"id": "names-019", "why": "A 64-byte label", "op": "parse_user", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "error": true, "error_contains": "names: label longer than 63 bytes"},
    {"id": "names-020", "why": "A label of exactly 63 bytes is fine", "op": "parse_user", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com"},

    {"id": "names-030", "why": "Wire parse of an uncompressed name", "op": "from_wire", "input": "076578616d706c6503636f6d00", "args": ["0"], "expect": "example.com next=13"},
    {"id": "names-031", "why": "Wire parse folds ASCII upper case to lower", "op": "from_wire", "input": "074578616D504C4503434F4D00", "args": ["0"], "expect": "example.com next=13"},
    {"id": "names-032", "why": "A compression pointer to an earlier name; next is after the pointer", "op": "from_wire", "input": "076578616d706c6503636f6d0003777777c000", "args": ["13"], "expect": "www.example.com next=19"},
    {"id": "names-033", "why": "A pointer to itself", "op": "from_wire", "input": "c000", "args": ["0"], "error": true, "error_contains": "names: compression pointer loop"},
    {"id": "names-034", "why": "A forward pointer is refused", "op": "from_wire", "input": "c00200", "args": ["0"], "error": true, "error_contains": "names: compression pointer loop"},
    {"id": "names-035", "why": "A compression loop (label then pointer back to the start): the name outgrows 255 bytes before any repeat is seen", "op": "from_wire", "input": "03616263c000", "args": ["0"], "error": true, "error_contains": "name longer than 255 bytes"},
    {"id": "names-036", "why": "Truncated label", "op": "from_wire", "input": "05616263", "args": ["0"], "error": true, "error_contains": "names: message truncated"},
    {"id": "names-037", "why": "Reserved label type 0x40", "op": "from_wire", "input": "4000", "args": ["0"], "error": true, "error_contains": "names: reserved label type"},
    {"id": "names-038", "why": "Reserved label type 0x80", "op": "from_wire", "input": "8000", "args": ["0"], "error": true, "error_contains": "names: reserved label type"},
    {"id": "names-039", "why": "No root byte before the message ends", "op": "from_wire", "input": "0161", "args": ["0"], "error": true, "error_contains": "names: message truncated"},
    {"id": "names-040", "why": "128 one-byte labels are 257 bytes: over the 255 limit", "op": "from_wire", "input": "", "args": ["0"], "error": true, "error_contains": "names: name longer than 255 bytes"},
    {"id": "names-041", "why": "127 one-byte labels are exactly 255 bytes and are legal", "op": "from_wire", "input": "", "args": ["0"], "expect": "a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a next=255"},
    {"id": "names-042", "why": "A dot inside a label prints as backslash-dot so it cannot be mistaken for a separator", "op": "from_wire", "input": "03412e4200", "args": ["0"], "expect": "a\\.b next=5"},
    {"id": "names-043", "why": "Bytes outside [a-z0-9_-] print as \\DDD (0xff)", "op": "from_wire", "input": "01ff00", "args": ["0"], "expect": "\\255 next=3"},
    {"id": "names-044", "why": "Bytes outside [a-z0-9_-] print as \\DDD (space)", "op": "from_wire", "input": "012000", "args": ["0"], "expect": "\\032 next=3"},
    {"id": "names-045", "why": "Non-LDH bytes are kept unchanged on the wire, only ASCII letters fold", "op": "from_wire", "input": "02c34100", "args": ["0"], "expect": "\\195a next=4"},
    {"id": "names-046", "why": "The root name", "op": "from_wire", "input": "00", "args": ["0"], "expect": ". next=1"},
    {"id": "names-050", "why": "Canonical wire form of a user name", "op": "wire_hex", "input": "Example.COM", "expect": "076578616d706c6503636f6d00"},
    {"id": "names-060", "why": "Suffix walk starts at min(labels, maxDepth) and goes to one label", "op": "suffixes", "input": "a.b.example.com", "args": ["3"], "expect": "3@2;2@4;1@12"},
    {"id": "names-061", "why": "A maxDepth above the label count starts at the full name", "op": "suffixes", "input": "a.b.example.com", "args": ["10"], "expect": "4@0;3@2;2@4;1@12"},
    {"id": "names-062", "why": "maxDepth 0 yields nothing", "op": "suffixes", "input": "a.b.example.com", "args": ["0"], "expect": ""},
    {"id": "names-070", "why": "Input over 1024 bytes is refused before IDNA runs (CPU guard); 1100 runes of u-umlaut (2200 bytes)", "op": "parse_user", "input": "ü", "repeat": 1100, "error": true, "error_contains": "names: input longer than MaxUserInput bytes"},
    {"id": "names-071", "why": "A 1024-byte input is still given to IDNA and refused only for its label length", "op": "parse_user", "input": "a", "repeat": 1024, "error": true, "error_contains": "names: label longer than 63 bytes"},
    {"id": "names-072", "why": "A 63-byte label is fine", "op": "parse_user", "input": "a", "repeat": 63, "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {"id": "names-080", "why": "Exactly one trailing dot is stripped; a second is an empty label (review L1-F12)", "op": "parse_user", "input": "example.com..", "error": true, "error_contains": "names: empty label"},
    {"id": "names-081", "why": "Three trailing dots", "op": "parse_user", "input": "example.com...", "error": true, "error_contains": "names: empty label"},
    {"id": "names-082", "why": "A trailing ideographic full stop is one dot after IDNA mapping", "op": "parse_user", "input": "example.com\u3002", "expect": "example.com"},
    {"id": "names-083", "why": "An ASCII dot after an ideographic one is two dots", "op": "parse_user", "input": "example.com.\u3002", "error": true, "error_contains": "names: empty label"},
    {"id": "names-084", "why": "A leading hyphen is a valid DNS name and blocklists have them (review L1-F12)", "op": "parse_user", "input": "-ad.example.com", "expect": "-ad.example.com"},
    {"id": "names-085", "why": "A trailing hyphen in a label", "op": "parse_user", "input": "ad-.example.com", "expect": "ad-.example.com"},
    {"id": "names-086", "why": "A double hyphen in positions 3 and 4 that is not xn--", "op": "parse_user", "input": "ab--c.com", "expect": "ab--c.com"},
    {"id": "names-087", "why": "A broken Punycode label is still refused", "op": "parse_user", "input": "xn--a.com", "error": true, "error_contains": "idna: invalid label"},
    {"id": "names-088", "why": "127.1 is an IPv4 address to a browser, not a domain", "op": "parse_user", "input": "127.1", "error": true, "error_contains": "names: the last label is a number, which resolvers read as an IPv4 address"},
    {"id": "names-089", "why": "Hex shorthand for an address", "op": "parse_user", "input": "0x7f.1", "error": true, "error_contains": "names: the last label is a number, which resolvers read as an IPv4 address"},
    {"id": "names-090", "why": "Hex in every label", "op": "parse_user", "input": "0x7f.0x0.0x0.0x1", "error": true, "error_contains": "names: the last label is a number, which resolvers read as an IPv4 address"},
    {"id": "names-091", "why": "A single decimal number is a 32-bit address", "op": "parse_user", "input": "2130706433", "error": true, "error_contains": "names: the last label is a number, which resolvers read as an IPv4 address"},
    {"id": "names-092", "why": "A name whose last label is a number", "op": "parse_user", "input": "example.123", "error": true, "error_contains": "names: the last label is a number, which resolvers read as an IPv4 address"},
    {"id": "names-093", "why": "A digit-leading label that is not the last is fine", "op": "parse_user", "input": "3com.com", "expect": "3com.com"},
    {"id": "names-094", "why": "A last label that merely starts with a digit is fine", "op": "parse_user", "input": "a.1password", "expect": "a.1password"},
    {"id": "names-095", "why": "0x with a non-hex digit is not a number", "op": "parse_user", "input": "a.0xg", "expect": "a.0xg"}
  ]
}
