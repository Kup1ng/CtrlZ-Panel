{
  "format": 1,
  "group": "locations-sets",
  "cases": [
    {"id": "locset-001", "why": "One pair: the intersection of what both nodes have. A label-only location sorts first", "op": "loc_allowed",
     "args": ["N1=DE:Frankfurt,NL:Amsterdam,US,~gateway-x", "N2=DE:Frankfurt,NL:Amsterdam,~gateway-x", "pairs=N1-N2"],
     "expect": "~gateway-x,DE:Frankfurt,NL:Amsterdam"},
    {"id": "locset-002", "why": "Two pairs (R1): a location must exist on all four nodes, so a profile used by both pairs gets the common set", "op": "loc_allowed",
     "args": ["N1=DE:Frankfurt,NL:Amsterdam,US", "N2=DE:Frankfurt,NL:Amsterdam", "N3=DE:Frankfurt,US", "N4=DE:Frankfurt,US", "pairs=N1-N2,N3-N4"],
     "expect": "DE:Frankfurt"},
    {"id": "locset-003", "why": "Two tenants on two pairs: tenant B's pair is not consulted for tenant A's profile", "op": "loc_allowed",
     "args": ["N1=DE:Frankfurt,NL:Amsterdam", "N2=DE:Frankfurt,NL:Amsterdam", "N3=US", "N4=US", "pairs=N1-N2"],
     "expect": "DE:Frankfurt,NL:Amsterdam"},
    {"id": "locset-004", "why": "No Endpoint uses the profile yet: the global pair decides", "op": "loc_allowed",
     "args": ["N1=DE:Frankfurt,US", "N2=US", "pairs=", "global=N1-N2"],
     "expect": "US"},
    {"id": "locset-005", "why": "A label-only config is shared only with the same label on the other node", "op": "loc_allowed",
     "args": ["N1=~a", "N2=~b", "pairs=N1-N2"],
     "expect": ""},
    {"id": "locset-006", "why": "A config with a country is identified by country and city; the node's own label does not matter", "op": "loc_allowed",
     "args": ["N1=DE:Frankfurt", "N2=DE:Frankfurt", "pairs=N1-N2"],
     "expect": "DE:Frankfurt"},
    {"id": "locset-007", "why": "City is compared folded: Tehran and tehran are one location, shown as the smaller spelling (review L1-F15)", "op": "loc_allowed",
     "args": ["N1=IR:Tehran", "N2=IR:tehran", "pairs=N1-N2"],
     "expect": "IR:Tehran"},
    {"id": "locset-008", "why": "The same, with the nodes swapped", "op": "loc_allowed",
     "args": ["N1=IR:tehran", "N2=IR:Tehran", "pairs=N1-N2"],
     "expect": "IR:Tehran"},
    {"id": "locset-009", "why": "The same on two pairs", "op": "loc_allowed",
     "args": ["N1=IR:Tehran", "N2=IR:tehran", "N3=IR:TEHRAN", "N4=IR:Tehran", "pairs=N1-N2,N3-N4"],
     "expect": "IR:TEHRAN"},
    {"id": "locset-010", "why": "A service with no regional limit keeps every allowed location", "op": "loc_service", "input": "DE:Frankfurt,NL:Amsterdam,US,~gw", "args": ["*"],
     "expect": "~gw,DE:Frankfurt,NL:Amsterdam,US"},
    {"id": "locset-011", "why": "A country region matches every city in it", "op": "loc_service", "input": "DE:Frankfurt,DE:Berlin,NL:Amsterdam", "args": ["de"],
     "expect": "DE:Berlin,DE:Frankfurt"},
    {"id": "locset-012", "why": "A CC-City region matches that city only", "op": "loc_service", "input": "DE:Frankfurt,DE:Berlin,NL:Amsterdam", "args": ["DE-Berlin,NL"],
     "expect": "DE:Berlin,NL:Amsterdam"},
    {"id": "locset-013", "why": "A label-only location never satisfies a limited service", "op": "loc_service", "input": "~gw,DE:Frankfurt", "args": ["DE"],
     "expect": "DE:Frankfurt"},
    {"id": "locset-014", "why": "An empty region list allows nothing", "op": "loc_service", "input": "DE:Frankfurt", "args": [""],
     "expect": ""},
    {"id": "locset-020", "why": "The effective selection is the intersection of the sets", "op": "loc_selection", "args": ["DE:Frankfurt,NL:Amsterdam", "NL:Amsterdam,US"],
     "expect": "NL:Amsterdam"},
    {"id": "locset-021", "why": "An empty effective selection disables Redirect with the shared-destination message", "op": "loc_selection", "args": ["DE:Frankfurt", "US"],
     "expect": ""}
  ]
}
