{
  "format": 1,
  "group": "options",
  "fixture": "base",
  "cases": [
    {"id": "opt-001", "why": "Rebind: a private answer under the Default Rule becomes the profile's Block Response", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/A": {"answer": ["public.example. 300 IN A 192.168.1.5"]}},
     "expect": {"action": "block", "stage": "default", "flags": ["rebind_blocked"], "answer": {"rcode": "NOERROR", "answer": ["public.example. 60 IN A 0.0.0.0"]}}},
    {"id": "opt-002", "why": "Rebind does not apply to an explicit Bypass: the user declared the intranet name", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "intranet.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"intranet.example/A": {"answer": ["intranet.example. 300 IN A 192.168.1.5"]}},
     "expect": {"action": "bypass", "stage": "rule", "flags": [], "answer": {"answer": ["intranet.example. 300 IN A 192.168.1.5"]}}},
    {"id": "opt-003", "why": "Rebind treats everything but public as private: CGNAT space counts", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/A": {"answer": ["public.example. 300 IN A 100.64.0.9"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"]}},
    {"id": "opt-004", "why": "Rebind passes a public answer untouched", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/A": {"answer": ["public.example. 300 IN A 93.184.216.34"]}},
     "expect": {"action": "bypass", "stage": "default", "flags": [], "answer": {"answer": ["public.example. 300 IN A 93.184.216.34"]}}},
    {"id": "opt-005", "why": "Rebind on AAAA: a unique-local address is private", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/AAAA": {"answer": ["public.example. 300 IN AAAA fd00::1"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"], "answer": {"answer": ["public.example. 60 IN AAAA ::"]}}},
    {"id": "opt-006", "why": "Rebind finds the private address behind a CNAME", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "alias.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"alias.example/A": {"chain": ["alias.example", "target.example"], "answer": ["alias.example. 300 IN CNAME target.example.", "target.example. 300 IN A 10.0.0.7"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"]}},
    {"id": "opt-007", "why": "Rebind with DNS64: a private A set must not escape as a synthesized 64:ff9b:: AAAA (the A query for the same name is blocked, so the AAAA query is too)", "endpoint": "e-opt-dns64-rebind", "client": "",
     "req": {"qname": "evil.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"evil.example/AAAA": {"answer": [], "authority": ["evil.example. 600 IN SOA ns.evil.example. h.evil.example. 1 3600 600 86400 600"]},
                  "evil.example/A": {"answer": ["evil.example. 300 IN A 192.168.1.1"]}},
     "expect": {"action": "block", "stage": "default", "flags": ["rebind_blocked"], "answer": {"answer": ["evil.example. 60 IN AAAA ::"]}}},
    {"id": "opt-008", "why": "Rebind with DNS64: a public A set is still synthesized", "endpoint": "e-opt-dns64-rebind", "client": "",
     "req": {"qname": "v4only.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"v4only.example/AAAA": {"answer": [], "authority": ["v4only.example. 600 IN SOA ns.v4only.example. h.v4only.example. 1 3600 600 86400 600"]},
                  "v4only.example/A": {"answer": ["v4only.example. 300 IN A 93.184.216.34"]}},
     "expect": {"action": "bypass", "flags": [], "answer": {"answer": ["v4only.example. 300 IN AAAA 64:ff9b::5db8:d822"]}}},
    {"id": "opt-009", "why": "Rebind sees through a NAT64 prefix in an upstream AAAA answer", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/AAAA": {"answer": ["public.example. 300 IN AAAA 64:ff9b::c0a8:101"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"]}},
    {"id": "opt-015", "why": "A Redirect that fell back to Bypass as location_unavailable is not the user's explicit Bypass: Rebind still applies although the stage is rule", "endpoint": "e-opt-rebind-loc", "client": "",
     "req": {"qname": "far.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"far.example/A": {"answer": ["far.example. 300 IN A 192.168.1.1"]}},
     "expect": {"action": "block", "stage": "rule", "ref": "rl-far", "flags": ["location_unavailable", "rebind_blocked"]}},
    {"id": "opt-016", "why": "The same fallback with a public answer stays Bypass with only location_unavailable", "endpoint": "e-opt-rebind-loc", "client": "",
     "req": {"qname": "far.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"far.example/A": {"answer": ["far.example. 300 IN A 93.184.216.34"]}},
     "expect": {"action": "bypass", "stage": "rule", "ref": "rl-far", "flags": ["location_unavailable"]}},


    {"id": "opt-010", "why": "DNS64 synthesizes AAAA from A when the AAAA answer is empty, at 64:ff9b::/96", "endpoint": "e-opt-dns64", "client": "",
     "req": {"qname": "v4only.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"v4only.example/AAAA": {"answer": [], "authority": ["v4only.example. 600 IN SOA ns.v4only.example. h.v4only.example. 1 3600 600 86400 600"]},
                  "v4only.example/A": {"answer": ["v4only.example. 300 IN A 93.184.216.34"]}},
     "expect": {"action": "bypass", "lookups": ["v4only.example/AAAA", "v4only.example/A"], "answer": {"rcode": "NOERROR", "ad": false, "answer": ["v4only.example. 300 IN AAAA 64:ff9b::5db8:d822"], "authority": []}}},
    {"id": "opt-011", "why": "DNS64 leaves a real AAAA answer alone and does not look up A", "endpoint": "e-opt-dns64", "client": "",
     "req": {"qname": "dual.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"dual.example/AAAA": {"answer": ["dual.example. 300 IN AAAA 2606:2800::1"]}},
     "expect": {"lookups": ["dual.example/AAAA"], "answer": {"answer": ["dual.example. 300 IN AAAA 2606:2800::1"]}}},
    {"id": "opt-012", "why": "Never on Block (R23): the blocked AAAA is ::, with no A lookup", "endpoint": "e-opt-dns64", "client": "",
     "req": {"qname": "bl.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"action": "block", "lookups": [], "answer": {"answer": ["bl.example. 60 IN AAAA ::"]}}},
    {"id": "opt-013", "why": "DNS64 does not turn NXDOMAIN into an answer", "endpoint": "e-opt-dns64", "client": "",
     "req": {"qname": "gone.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"gone.example/AAAA": {"rcode": "NXDOMAIN", "answer": []}},
     "expect": {"lookups": ["gone.example/AAAA"], "answer": {"rcode": "NXDOMAIN", "answer": []}}},
    {"id": "opt-014", "why": "DNS64 keeps the CNAME in front of the synthesized AAAA", "endpoint": "e-opt-dns64", "client": "",
     "req": {"qname": "cdn.example", "qtype": "AAAA", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"cdn.example/AAAA": {"chain": ["cdn.example", "edge.example"], "answer": ["cdn.example. 300 IN CNAME edge.example."]},
                  "cdn.example/A": {"chain": ["cdn.example", "edge.example"], "answer": ["cdn.example. 300 IN CNAME edge.example.", "edge.example. 60 IN A 93.184.216.34"]}},
     "expect": {"answer": {"answer": ["cdn.example. 300 IN CNAME edge.example.", "edge.example. 60 IN AAAA 64:ff9b::5db8:d822"]}}},

    {"id": "opt-020", "why": "Flatten: the chain collapses to one record at the qname with the minimum TTL, RRSIG removed and AD clear", "endpoint": "e-opt-flatten", "client": "",
     "req": {"qname": "cdn.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh", "do": true},
     "upstream": {"cdn.example/A": {"chain": ["cdn.example", "edge.example"], "validation": "secure",
                  "answer": ["cdn.example. 100 IN CNAME edge.example.", "edge.example. 20 IN A 93.184.216.34", "edge.example. 20 IN RRSIG \\# 2 abcd"]}},
     "expect": {"action": "bypass", "answer": {"ad": false, "answer": ["cdn.example. 20 IN A 93.184.216.34"]}}},
    {"id": "opt-021", "why": "Flatten does nothing when there is no CNAME", "endpoint": "e-opt-flatten", "client": "",
     "req": {"qname": "plain.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"plain.example/A": {"answer": ["plain.example. 100 IN A 93.184.216.34"]}},
     "expect": {"answer": {"answer": ["plain.example. 100 IN A 93.184.216.34"]}}},
    {"id": "opt-022", "why": "Flatten applies to A and AAAA only: an MX answer keeps its CNAME", "endpoint": "e-opt-flatten", "client": "",
     "req": {"qname": "cdn.example", "qtype": "MX", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"cdn.example/MX": {"chain": ["cdn.example", "edge.example"], "answer": ["cdn.example. 100 IN CNAME edge.example.", "edge.example. 20 IN MX 10 mail.edge.example."]}},
     "expect": {"answer": {"answer": ["cdn.example. 100 IN CNAME edge.example.", "edge.example. 20 IN MX 10 mail.edge.example."]}}},

    {"id": "opt-030", "why": "ECS Auto sends the client's /24 and echoes it with the returned scope", "endpoint": "e-opt-ecs-auto", "client": "",
     "req": {"qname": "geo.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.7.9", "protocol": "doh"},
     "upstream": {"geo.example/A": {"answer": ["geo.example. 60 IN A 93.184.216.34"], "ecs_scope": 24}},
     "expect": {"answer": {"ecs": "5.160.7.0/24 scope 24"}}},
    {"id": "opt-031", "why": "ECS Auto uses /56 for an IPv6 client", "endpoint": "e-opt-ecs-auto", "client": "",
     "req": {"qname": "geo.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "2001:db8:1:2::5", "protocol": "doh"},
     "upstream": {"geo.example/A": {"answer": ["geo.example. 60 IN A 93.184.216.34"], "ecs_scope": 0}},
     "expect": {"answer": {"ecs": "2001:db8:1::/56 scope 0"}}},
    {"id": "opt-032", "why": "ECS Custom sends the configured subnet whatever the client address is", "endpoint": "e-opt-ecs-custom", "client": "",
     "req": {"qname": "geo.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.7.9", "protocol": "doh"},
     "upstream": {"geo.example/A": {"answer": ["geo.example. 60 IN A 93.184.216.34"], "ecs_scope": 24}},
     "expect": {"answer": {"ecs": "203.0.113.0/24 scope 24"}}},
    {"id": "opt-033", "why": "No ECS option: nothing is sent or echoed", "endpoint": "e-prec", "client": "",
     "req": {"qname": "geo.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.7.9", "protocol": "doh"},
     "upstream": {"geo.example/A": {"answer": ["geo.example. 60 IN A 93.184.216.34"], "ecs_scope": 24}},
     "expect": {"answer": {"ecs": "none"}}},
    {"id": "opt-034", "why": "ECS scope defaults to 0 when the upstream returned none", "endpoint": "e-opt-ecs-auto", "client": "",
     "req": {"qname": "geo.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.7.9", "protocol": "doh"},
     "upstream": {"geo.example/A": {"answer": ["geo.example. 60 IN A 93.184.216.34"]}},
     "expect": {"answer": {"ecs": "5.160.7.0/24 scope 0"}}},

    {"id": "opt-040", "why": "Bypass TTL replaces every answer TTL, CNAME included", "endpoint": "e-opt-ttl", "client": "",
     "req": {"qname": "cdn.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"cdn.example/A": {"chain": ["cdn.example", "edge.example"], "answer": ["cdn.example. 300 IN CNAME edge.example.", "edge.example. 20 IN A 93.184.216.34"]}},
     "expect": {"answer": {"answer": ["cdn.example. 120 IN CNAME edge.example.", "edge.example. 120 IN A 93.184.216.34"]}}},

    {"id": "opt-050", "why": "Exfiltration: a label over 40 bytes blocks, attributed to the exfiltration check", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"pre_done": true, "action": "block", "stage": "filter", "ref": "exfiltration"}},
    {"id": "opt-051", "why": "A label of exactly 40 bytes is fine", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/A": {"answer": []}},
     "expect": {"pre_done": false, "action": "bypass", "stage": "default"}},
    {"id": "opt-052", "why": "Exfiltration: qtype NULL blocks", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "tunnel.example.com", "qtype": "NULL", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"pre_done": true, "action": "block", "ref": "exfiltration"}},
    {"id": "opt-053", "why": "Exfiltration: a name over 180 bytes in wire form blocks even when every label is short", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddd.eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee.com", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"pre_done": true, "action": "block", "ref": "exfiltration"}},
    {"id": "opt-054", "why": "Exfiltration is off by default: the same long label passes in another profile", "endpoint": "e-empty", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/A": {"answer": []}},
     "expect": {"action": "bypass", "stage": "default"}},
    {"id": "opt-055", "why": "Exfiltration ranks after filters: a listed name is attributed to the filter first", "endpoint": "e-prec", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.tracker.example", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"pre_done": true, "action": "block", "stage": "filter", "ref": "filter:1"}},
    {"id": "opt-017", "why": "Rebind also reads the ipv4hint of an HTTPS record: a public name publishing a private hint is blocked", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 11 00010000040004c0a80101"]}},
     "expect": {"action": "block", "stage": "default", "flags": ["rebind_blocked"]}},
    {"id": "opt-018", "why": "Rebind reads the ipv6hint too (unique-local)", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 23 00010000060010fd000000000000000000000000000001"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"]}},
    {"id": "opt-019", "why": "SVCB is read like HTTPS, and the hint may follow other SvcParams (alpn first)", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "SVCB", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/SVCB": {"answer": ["public.example. 300 IN SVCB \\# 18 0001000001000302683200040004c0a80101"]}},
     "expect": {"action": "block", "flags": ["rebind_blocked"]}},
    {"id": "opt-023", "why": "A public ipv4hint, behind a non-root target name, passes untouched", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 27 000103737663076578616d706c65036e657400000400045db8d822"]}},
     "expect": {"action": "bypass", "stage": "default", "flags": []}},
    {"id": "opt-024", "why": "A malformed ipv4hint (3 bytes) is no address at all: nothing is blocked and nothing panics", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 10 00010000040003c0a801"]}},
     "expect": {"action": "bypass", "stage": "default", "flags": []}},
    {"id": "opt-025", "why": "A SvcParam longer than the record is truncated: the partial bytes are not read as an address", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 11 00010000040008c0a80101"]}},
     "expect": {"action": "bypass", "stage": "default", "flags": []}},
    {"id": "opt-026", "why": "Rebind on an explicit Bypass still does not apply to a hint (the user declared the intranet name)", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "intranet.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"intranet.example/HTTPS": {"answer": ["intranet.example. 300 IN HTTPS \\# 11 00010000040004c0a80101"]}},
     "expect": {"action": "bypass", "stage": "rule", "flags": []}},
    {"id": "opt-056", "why": "Exfiltration: a name of exactly 180 bytes in wire form (four 40-byte labels and one of 14) is not over the limit", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddd.eeeeeeeeeeeeee", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddd.eeeeeeeeeeeeee/A": {"answer": []}},
     "expect": {"pre_done": false, "action": "bypass", "stage": "default"}},
    {"id": "opt-057", "why": "Exfiltration: 181 bytes in wire form blocks, with no label over 40 bytes to blame", "endpoint": "e-opt-exfil", "client": "",
     "req": {"qname": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddd.eeeeeeeeeeeeeee", "qtype": "A", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {},
     "expect": {"pre_done": true, "action": "block", "stage": "filter", "ref": "exfiltration"}},
    {"id": "opt-058", "why": "Rebind reads the ipv4hint behind a compression pointer in the target: RFC 9460 forbids the form, but a client parser that follows pointers would read the private hint, so the scan skips the two pointer bytes and goes on to the params", "endpoint": "e-opt-rebind", "client": "",
     "req": {"qname": "public.example", "qtype": "HTTPS", "now": "2026-11-06T10:00:00Z", "src": "5.160.0.1", "protocol": "doh"},
     "upstream": {"public.example/HTTPS": {"answer": ["public.example. 300 IN HTTPS \\# 12 0001c00c00040004c0a80101"]}},
     "expect": {"action": "block", "stage": "default", "flags": ["rebind_blocked"]}}
  ]
}
