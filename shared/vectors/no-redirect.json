{
  "format": 1,
  "group": "no-redirect",
  "cases": [
    {"id": "nr-001", "why": "the TLD .ir itself as a domain pattern", "op": "no_redirect", "input": "ir", "expect": "iranian_name"},
    {"id": "nr-002", "why": "the TLD in its U-label spelling", "op": "no_redirect", "input": "ایران", "expect": "iranian_name"},
    {"id": "nr-003", "why": "the TLD in its A-label spelling", "op": "no_redirect", "input": "xn--mgba3a4f16a", "expect": "iranian_name"},
    {"id": "nr-004", "why": "a name under .ir", "op": "no_redirect", "input": "example.ir", "expect": "iranian_name"},
    {"id": "nr-005", "why": "a deeper name under .ir", "op": "no_redirect", "input": "www.shop.example.ir", "expect": "iranian_name"},
    {"id": "nr-006", "why": "a name under .ایران in its U-label spelling", "op": "no_redirect", "input": "example.ایران", "expect": "iranian_name"},
    {"id": "nr-007", "why": "a name under .ایران in its A-label spelling", "op": "no_redirect", "input": "example.xn--mgba3a4f16a", "expect": "iranian_name"},
    {"id": "nr-008", "why": "an upper case name under .ir is the same name", "op": "no_redirect", "input": "EXAMPLE.IR", "expect": "iranian_name"},
    {"id": "nr-009", "why": "a domain entry covers its own name", "op": "no_redirect", "input": "digikala.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "iranian_name"},
    {"id": "nr-010", "why": "a domain entry covers the names under it", "op": "no_redirect", "input": "www.digikala.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "iranian_name"},
    {"id": "nr-011", "why": "a domain entry covers the names far under it", "op": "no_redirect", "input": "a.b.c.digikala.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "iranian_name"},
    {"id": "nr-012", "why": "a host entry covers its exact name", "op": "no_redirect", "input": "shop.example.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "iranian_name"},
    {"id": "nr-013", "why": "a host entry does not cover the names under it", "op": "no_redirect", "input": "www.shop.example.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "allowed"},
    {"id": "nr-014", "why": "a host entry does not cover its parent", "op": "no_redirect", "input": "example.com", "args": ["domain:digikala.com", "host:shop.example.com"], "expect": "allowed"},
    {"id": "nr-015", "why": "a name that merely contains ir", "op": "no_redirect", "input": "ir.example.com", "expect": "allowed"},
    {"id": "nr-016", "why": "a name that merely ends in the letters ir", "op": "no_redirect", "input": "airlir.com", "expect": "allowed"},
    {"id": "nr-017", "why": "iran as a label of a .com name", "op": "no_redirect", "input": "iran.com", "expect": "allowed"},
    {"id": "nr-018", "why": "ir as the second label of a .com name", "op": "no_redirect", "input": "example.ir.com", "expect": "allowed"},
    {"id": "nr-019", "why": "a trailing dot is not part of the name", "op": "no_redirect", "input": "digikala.com.", "args": ["domain:digikala.com"], "expect": "iranian_name"},
    {"id": "nr-020", "why": "a star over the TLD is no pattern at all", "op": "no_redirect", "input": "*.ir", "error": true, "error_contains": "registrable domain"},
    {"id": "nr-021", "why": "a star over the other TLD is no pattern at all", "op": "no_redirect", "input": "*.ایران", "error": true, "error_contains": "registrable domain"},
    {"id": "nr-022", "why": "a wildcard whose suffix is under .ir", "op": "no_redirect", "input": "*.example.ir", "expect": "iranian_name"},
    {"id": "nr-023", "why": "a wildcard whose suffix is under .ایران", "op": "no_redirect", "input": "*.example.ایران", "expect": "iranian_name"},
    {"id": "nr-024", "why": "a wildcard whose suffix is a domain entry", "op": "no_redirect", "input": "*.digikala.com", "args": ["domain:digikala.com"], "expect": "iranian_name"},
    {"id": "nr-025", "why": "a glob whose suffix is a domain entry", "op": "no_redirect", "input": "server-*.digikala.com", "args": ["domain:digikala.com"], "expect": "iranian_name"},
    {"id": "nr-026", "why": "a glob with a whole-label star over an .ir suffix", "op": "no_redirect", "input": "a.*.example.ir", "expect": "iranian_name"},
    {"id": "nr-027", "why": "a wildcard whose suffix is a host entry: the wildcard never matches that name itself", "op": "no_redirect", "input": "*.shop.example.com", "args": ["host:shop.example.com"], "expect": "allowed"},
    {"id": "nr-028", "why": "a wildcard over an ordinary name", "op": "no_redirect", "input": "*.example.com", "args": ["domain:digikala.com"], "expect": "allowed"},
    {"id": "nr-029", "why": "a glob over an ordinary name", "op": "no_redirect", "input": "server-*.example.com", "args": ["domain:digikala.com"], "expect": "allowed"},
    {"id": "nr-030", "why": "destination country IR", "op": "no_redirect", "input": "@IR", "expect": "iranian_name"},
    {"id": "nr-031", "why": "destination country IR in lower case", "op": "no_redirect", "input": "@ir", "expect": "iranian_name"},
    {"id": "nr-032", "why": "everything but IR is not a name that is never proxied", "op": "no_redirect", "input": "!@IR", "expect": "allowed"},
    {"id": "nr-033", "why": "another destination country", "op": "no_redirect", "input": "@DE", "expect": "allowed"},
    {"id": "nr-034", "why": "a source country IR is about the client, not the destination", "op": "no_redirect", "input": "#IR", "expect": "allowed"},
    {"id": "nr-035", "why": "an AS pattern names no name", "op": "no_redirect", "input": "@AS12880", "expect": "allowed"},
    {"id": "nr-036", "why": "a domain entry does not match a longer label that starts with it", "op": "no_redirect", "input": "mydigikala.com", "args": ["domain:digikala.com"], "expect": "allowed"}
  ]
}
