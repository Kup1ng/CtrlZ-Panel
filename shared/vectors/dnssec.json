     "expect": {"action": "bypass", "stage": "default", "hop": 0, "flags": [], "answer": {"rcode": "SERVFAIL", "answer": []}}},
    {"id": "dnssec-014", "why": "The same Bogus chain with CD on is walked as before", "endpoint": "e-cn-bypassdef", "client": "",
