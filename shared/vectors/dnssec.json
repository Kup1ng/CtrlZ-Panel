     "upstream": {"x.test/A": {"validation": "secure", "answer": ["x.test. 300 IN A 93.184.216.34", "x.test. 300 IN RRSIG \\# 2 abcd"]}},
     "expect": {"answer": {"ad": false, "answer": ["x.test. 300 IN A 93.184.216.34"]}}},
    {"id": "dnssec-003", "why": "Client sent the AD bit but not DO: AD is set, signatures are still stripped (DO=0)", "endpoint": "e-qm-bypass", "client": "",
