     "upstream": {"x.test/A": {"validation": "secure", "answer": ["x.test. 300 IN A 93.184.216.34", "x.test. 300 IN RRSIG \\# 2 abcd"]}},
     "expect": {"answer": {"ad": true, "answer": ["x.test. 300 IN A 93.184.216.34", "x.test. 300 IN RRSIG \\# 2 abcd"]}}},
    {"id": "dnssec-002", "why": "Secure answer, client sent neither DO nor AD: AD clear and RRSIG stripped", "endpoint": "e-qm-bypass", "client": "",
