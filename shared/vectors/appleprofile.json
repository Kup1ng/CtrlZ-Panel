    {"id": "apple-001", "why": "The smallest request: DoH, nothing excluded; empty lists are [] and every field is present", "op": "apple_expand", "input": "{\"protocol\":\"doh\"}", "expect": "{\"client\":\"\",\"protocol\":\"doh\",\"excluded_ssids\":[],\"excluded_domains\":[],\"prohibit_disablement\":false}"},
