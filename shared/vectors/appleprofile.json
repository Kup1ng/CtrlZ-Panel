    {"id": "apple-003", "why": "Without exclude_common the catalog list is not used", "op": "apple_expand", "input": "{\"protocol\":\"doh\",\"excluded_domains\":[\"example.com\"]}", "args": ["[\"local\"]"], "expect": "{\"client\":\"\",\"protocol\":\"doh\",\"excluded_ssids\":[],\"excluded_domains\":[\"example.com\"],\"prohibit_disablement\":false}"},
