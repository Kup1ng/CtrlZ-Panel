{
  "format": 1,
  "group": "telemetry-validate",
  "fixture": "",
  "cases": [
    {"id":"tv-001","why":"An entry with a source_ip_hash only: a prefix of the Endpoint's authorized list holds the source","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-002","why":"An entry with a claim_id only: the source address has an IP claim","op":"activity","input":{"entries":[{"claim_len":16,"hash_len":0,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-003","why":"An entry with neither: the source is in no claim and in no authorized prefix (p4-nodes 7.6), and it still counts the device as alive","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":0,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-004","why":"An entry with both is refused: one entry never carries two identities","op":"activity","input":{"entries":[{"claim_len":16,"hash_len":16,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"both claim_id and source_ip_hash are set"}},
    {"id":"tv-005","why":"A claim_id of 15 bytes","op":"activity","input":{"entries":[{"claim_len":15,"hash_len":0,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"claim_id is 15 bytes, want 16"}},
    {"id":"tv-006","why":"A source_ip_hash of 15 bytes","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":15,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"source_ip_hash is 15 bytes, want 16"}},
    {"id":"tv-007","why":"A source_ip_hash of 32 bytes","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":32,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"source_ip_hash is 32 bytes, want 16"}},
    {"id":"tv-008","why":"An entry with neither still needs a client label","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":0,"label":"","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"client_label is not a client label"}},
    {"id":"tv-009","why":"A query that names no client sends the label default, with a claim","op":"activity","input":{"entries":[{"claim_len":16,"hash_len":0,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-010","why":"A client label of a device","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"kid-tv","protocol":"udp","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-011","why":"A label that is not the client grammar","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"Kid TV","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"client_label is not a client label"}},
    {"id":"tv-012","why":"Over DoH3 (D51)","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"default","protocol":"doh3","first":-600,"last":-300}]},"expect":{"ok":true}},
    {"id":"tv-013","why":"A bucket that is not on a 5-minute boundary","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"default","protocol":"udp","first":-601,"last":-301}]},"expect":{"error":true,"error_contains":"buckets not on 5-minute boundaries"}},
    {"id":"tv-014","why":"A bucket ahead of the receiver by more than the skew","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"default","protocol":"udp","first":600,"last":600}]},"expect":{"error":true,"error_contains":"first_seen_bucket 1800000600 against the receiver"}},
    {"id":"tv-015","why":"One bad entry among good ones refuses the batch","op":"activity","input":{"entries":[{"claim_len":0,"hash_len":16,"label":"default","protocol":"udp","first":-600,"last":-300},{"claim_len":0,"hash_len":15,"label":"default","protocol":"udp","first":-600,"last":-300},{"claim_len":0,"hash_len":16,"label":"default","protocol":"udp","first":-600,"last":-300}]},"expect":{"error":true,"error_contains":"source_ip_hash is 15 bytes"}},
    {"id":"tv-016","why":"A free part of three items","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"ok":true}},
