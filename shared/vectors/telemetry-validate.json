    {"id":"tv-021","why":"rcode 24","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":24,"count":"1"}],"repeat":0},"expect":{"error":true,"error_contains":"rcode 24"}},
    {"id":"tv-022","why":"A protocol that is not Plain DNS: DoT","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"dot","outcome":"answered","rcode":0,"count":"1"}],"repeat":0},"expect":{"error":true,"error_contains":"protocol"}},
