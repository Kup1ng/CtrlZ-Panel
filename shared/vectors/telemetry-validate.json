    {"id":"tv-025","why":"The outcome myip","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"tcp","outcome":"myip","rcode":5,"count":"1"}],"repeat":0},"expect":{"ok":true}},
