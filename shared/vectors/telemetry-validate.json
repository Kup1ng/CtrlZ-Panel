    {"id":"tv-028","why":"The same outcome with another rcode is another item","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"1"},{"protocol":"udp","outcome":"answered","rcode":2,"count":"2"}],"repeat":0},"expect":{"ok":true}},
    {"id":"tv-029","why":"A bucket_start that is not a multiple of 300","op":"free_counters","input":{"bucket":-601,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"error":true,"error_contains":"is not a multiple of 300"}},
    {"id":"tv-030","why":"A bucket 25 hours old","op":"free_counters","input":{"bucket":-90000,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"ok":true}},
    {"id":"tv-031","why":"A bucket older than 25 hours","op":"free_counters","input":{"bucket":-90300,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"error":true,"error_contains":"against the receiver"}},
    {"id":"tv-032","why":"A bucket 5 minutes ahead","op":"free_counters","input":{"bucket":300,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"ok":true}},
    {"id":"tv-033","why":"A bucket 10 minutes ahead","op":"free_counters","input":{"bucket":600,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"10"},{"protocol":"udp","outcome":"hop","rcode":0,"count":"1"},{"protocol":"tcp","outcome":"answered","rcode":3,"count":"2"}],"repeat":0},"expect":{"error":true,"error_contains":"against the receiver"}},
    {"id":"tv-034","why":"672 items, every protocol, outcome and rcode a node can count in a bucket","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[],"repeat":672},"expect":{"ok":true}},
    {"id":"tv-035","why":"673 items","op":"free_counters","input":{"bucket":-600,"counters":0,"free":[{"protocol":"udp","outcome":"answered","rcode":0,"count":"1"}],"repeat":672},"expect":{"error":true,"error_contains":"673 items"}}
  ]
