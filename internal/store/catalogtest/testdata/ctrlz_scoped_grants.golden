execute ctrlz_fn.admin_one_time_state(p_user_id uuid)
execute ctrlz_fn.admin_reissue_one_time_password(p_user_id uuid, p_password_hash text)
execute ctrlz_fn.admin_revoke_user_sessions(p_user_id uuid)
