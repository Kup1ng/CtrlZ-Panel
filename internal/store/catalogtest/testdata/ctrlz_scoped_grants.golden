execute ctrlz_fn.auth_totp_seed(p_user_id uuid, p_tenant_id uuid)
execute ctrlz_fn.auth_user_flags(p_user_id uuid)
execute ctrlz_fn.endpoint_pair_ips()
execute ctrlz_fn.keytool_totp_declare_lost(p_key_number integer, p_user_ids uuid[], p_cts bytea[])
execute ctrlz_fn.tenant_plan()
execute ctrlz_fn.tenant_set_password(p_user_id uuid, p_password_hash text)
execute ctrlz_fn.worker_enforce_clear_without_live(p_rp_id text)
execute ctrlz_fn.worker_passkeys_mark_stale(p_rp_id text)
execute ctrlz_fn.worker_sweep_pending_totp(p_limit integer)
