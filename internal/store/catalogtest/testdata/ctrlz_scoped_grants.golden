schema ctrlz USAGE
table announcements SELECT
table endpoints SELECT (id, pair_override_node_a, pair_override_node_b, tenant_id)
table node_pairs SELECT
table nodes SELECT (dns_advertised_ip, id)
table notifications INSERT (kind, params, severity, tenant_id)
table plans SELECT (id, max_api_tokens, max_authorized_ips, max_clients_per_endpoint, max_endpoints, max_ip_claims, max_profiles, max_publishes_per_hour, max_realtime_sessions, max_rules_per_profile, max_rules_per_request, max_wildcards_per_profile, name)
table public_settings SELECT
table refresh_tokens SELECT (id, revoked_at, tenant_id, user_id)
table refresh_tokens UPDATE (revoked_at)
table sessions SELECT (id, revoked_at, tenant_id, user_id)
table sessions UPDATE (revoked_at)
table tenant_audit_log INSERT (action, params, target, tenant_id, user_id)
table tenant_entitlements SELECT
table tenants SELECT (id, plan_id, status)
table users SELECT (enforce_passkey, id, must_reset, password_expires_at, password_hash, tenant_id, totp_enabled_at, totp_pending_at, totp_secret_ct)
table users UPDATE (enforce_passkey, must_reset, password_changed_at, password_expires_at, password_hash, totp_enabled_at, totp_last_step, totp_pending_at, totp_secret_ct)
table webauthn_config SELECT (rp_id)
table webauthn_credentials SELECT (id, rp_id, stale_at, tenant_id, user_id)
table webauthn_credentials UPDATE (stale_at)
