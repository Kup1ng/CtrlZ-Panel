# Copy to .env, or let scripts/select-profile.sh write it from the detected RAM.
# The profile file (profiles/standard.env or profiles/small.env) supplies the
# memory and connection numbers; this file only adds what is specific to a host.
# Never put a password here: passwords are Docker secrets (secrets/*).

# Marks this file as the layout docker-compose.yml expects. Compose refuses to run without it, so an .env
# written for an earlier layout (floating image tags, a Valkey memory size sized for one server) is written
# again by scripts/select-profile.sh --force and not kept by accident. Do not remove it.
CTRLZ_ENV_FORMAT_2=1

# The Panel image is built locally from deploy/docker/Dockerfile and never pulled (pull_policy: never). The
# images of Postgres, ClickHouse, Valkey, Caddy and the placeholder are NOT named here: docker-compose.yml pins
# each by tag and digest as a literal, and no variable overrides it (round 17, admin-r17-6).
CTRLZ_IMAGE=ctrlz/panel:dev

# Hostnames for the two dashboards (D20: the panel stays outside the delegated
# dns zone). The defaults only work on the machine itself.
CTRLZ_PANEL_HOST=panel.localhost
CTRLZ_ADMIN_HOST=admin.localhost

# The origins of the DNS verify probe (p4-nodes 10.3), https://*.verify.<zone>, comma separated. Do not set it by hand:
# scripts/domain-apply.sh writes it, together with the two hosts above, from what the admin saved.
CTRLZ_VERIFY_ORIGIN=

# The names and addresses nodes reach the hub by (the node port, TCP 9443, published by the hub), comma separated:
# the install command is made from the first, and the hub's TLS leaf carries all of them. The default only works on
# the machine itself; a real install sets the panel server's public address or name.
CTRLZ_HUB_HOST=localhost

# The resolvers of the worker (p6-ops 9.5): the DDNS host names tenants enter and the SMS gateways are looked up through these
# addresses and no other, from the worker's own network, where the firewall table sees them. The first is required and is no
# loopback address (a resolver on 127.0.0.1 would be reached by Docker from the host and bypass the table); the second and third
# default to the first. Compose refuses to start with the first unset, so a worker never resolves through the host by accident.
# The line is a comment so that the file written by select-profile.sh does not start the stack with a made-up resolver: remove the
# # and write the address of a resolver the host reaches over the network.
# CTRLZ_WORKER_DNS1=
# CTRLZ_WORKER_DNS2=
# CTRLZ_WORKER_DNS3=

# Host ports. 80 and 443 are the front door; the hub also publishes 9443 for the nodes. No database port is ever published.
CTRLZ_HTTP_PORT=80
CTRLZ_HTTPS_PORT=443

# Where the secret files live, relative to this directory.
CTRLZ_SECRETS_DIR=../../secrets
