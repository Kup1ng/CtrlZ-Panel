# Copy to .env, or let scripts/select-profile.sh write it from the detected RAM.
# The profile file (profiles/standard.env or profiles/small.env) supplies the
# memory and connection numbers; this file only adds what is specific to a host.
# Never put a password here: passwords are Docker secrets (secrets/*).

# The Panel image is built locally from deploy/docker/Dockerfile. The images of Postgres, ClickHouse,
# Valkey, Caddy and the placeholder are NOT named here: docker-compose.yml pins each by tag and digest
# and is the one place that does (round 16, admin-r16-9). A copy here would override the pin and drift.
# To run another build, add POSTGRES_IMAGE, CLICKHOUSE_IMAGE, VALKEY_IMAGE, CADDY_IMAGE or
# PLACEHOLDER_IMAGE below, with a digest.
CTRLZ_IMAGE=ctrlz/panel:dev

# Hostnames for the two dashboards (D20: the panel stays outside the delegated
# dns zone). The defaults only work on the machine itself.
CTRLZ_PANEL_HOST=panel.localhost
CTRLZ_ADMIN_HOST=admin.localhost

# Host ports. 80 and 443 are the front door, the only ports published in P1. The hub
# publishes nothing until the node channel (mTLS) exists in P4. No database port is ever published.
CTRLZ_HTTP_PORT=80
CTRLZ_HTTPS_PORT=443

# Where the secret files live, relative to this directory.
CTRLZ_SECRETS_DIR=../../secrets
