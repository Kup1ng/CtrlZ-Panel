# Compose profile "standard": a host with 16 GB of RAM or more.
# Provisional numbers (D31): they are replaced by measured ones after the P4
# load test. scripts/select-profile.sh copies the right profile to .env.

CTRLZ_PROFILE=standard

# Memory limits per container (Compose mem_limit).
MEM_POSTGRES=4g
MEM_CLICKHOUSE=8g
# MEM_VALKEY and VALKEY_MAXMEMORY are for each of the two Valkey zones (api, admin): two servers, one trust zone each.
MEM_VALKEY=256m
MEM_API=512m
MEM_ADMIN=256m
MEM_WORKER=512m
MEM_HUB=1g
MEM_CADDY=256m
MEM_WEB=256m

# Postgres tuning, passed as -c flags.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=200
PG_SHM_SIZE=1g

# Per-role connection limits and timeouts, applied once by the bootstrap.
CTRLZ_PG_CONN_MIGRATOR=5
CTRLZ_PG_CONN_TENANT=60
CTRLZ_PG_CONN_HUB=30
CTRLZ_PG_CONN_COMPILER=10
CTRLZ_PG_CONN_WORKER=30
CTRLZ_PG_CONN_ADMIN=15
# The key tool (ctrlz_keytool): the CONN name avoids "KEY", which the secret lint reads as a secret.
CTRLZ_PG_CONN_TOOLS=4
CTRLZ_PG_STATEMENT_TIMEOUT=30s
CTRLZ_PG_LOCK_TIMEOUT=5s
CTRLZ_PG_IDLE_TX_TIMEOUT=60s
CTRLZ_PG_TX_TIMEOUT=120s

# Pool sizes of the Go roles (must stay under the role limits above; one pool per service,
# a request holds one connection at a time, so the size is the whole footprint).
CTRLZ_API_DB_MAX_CONNS=40
CTRLZ_ADMIN_DB_MAX_CONNS=8
CTRLZ_WORKER_DB_MAX_CONNS=10
CTRLZ_HUB_DB_MAX_CONNS=13

# ClickHouse and Valkey.
CH_MAX_SERVER_MEMORY_USAGE=6000000000
VALKEY_MAXMEMORY=128mb

# Password hashing gate and Go memory ceilings (spec 4.1).
CTRLZ_API_ARGON2_CONCURRENCY=4
CTRLZ_API_ARGON2_BUDGET_MIB=256
GOMEMLIMIT_API=420MiB
GOMEMLIMIT_ADMIN=200MiB
GOMEMLIMIT_WORKER=420MiB
GOMEMLIMIT_HUB=900MiB
