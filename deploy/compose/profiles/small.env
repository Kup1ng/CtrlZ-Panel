# Compose profile "small": a host with less than 12 GB of RAM (the plan's floor
# is 8 GB). Everything runs, with smaller buffers and fewer connections. The
# containers together stay under about 5.5 GB, which leaves room for the
# kernel, the page cache and Docker itself. Provisional (D31, R37).

CTRLZ_PROFILE=small

MEM_POSTGRES=1536m
MEM_CLICKHOUSE=2560m
# MEM_VALKEY and VALKEY_MAXMEMORY are for each of the two Valkey zones (api, admin): two servers, one trust zone each.
MEM_VALKEY=128m
MEM_API=256m
MEM_ADMIN=128m
MEM_WORKER=256m
MEM_HUB=640m
MEM_CADDY=128m
MEM_WEB=128m

PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=96MB
PG_MAX_CONNECTIONS=63
PG_SHM_SIZE=512m

CTRLZ_PG_CONN_MIGRATOR=3
CTRLZ_PG_CONN_TENANT=20
CTRLZ_PG_CONN_HUB=13
CTRLZ_PG_CONN_COMPILER=4
CTRLZ_PG_CONN_WORKER=10
CTRLZ_PG_CONN_ADMIN=8
# The key tool (ctrlz_keytool): the CONN name avoids "KEY", which the secret lint reads as a secret.
CTRLZ_PG_CONN_TOOLS=4
CTRLZ_PG_STATEMENT_TIMEOUT=30s
CTRLZ_PG_LOCK_TIMEOUT=5s
CTRLZ_PG_IDLE_TX_TIMEOUT=60s
CTRLZ_PG_TX_TIMEOUT=120s

# One pool per service: a request holds one connection at a time, so the pool size is the
# footprint (there is no second lookup pool; the old 8+8 and 3+2 became 16 and 5).
CTRLZ_API_DB_MAX_CONNS=16
CTRLZ_ADMIN_DB_MAX_CONNS=5
CTRLZ_WORKER_DB_MAX_CONNS=4
CTRLZ_HUB_DB_MAX_CONNS=7

CH_MAX_SERVER_MEMORY_USAGE=2000000000
VALKEY_MAXMEMORY=64mb

# Password hashing gate and Go memory ceilings (spec 4.1). The ceiling sits under
# the container limit so the collector returns memory before the cgroup kill.
CTRLZ_API_ARGON2_CONCURRENCY=2
CTRLZ_API_ARGON2_BUDGET_MIB=128
GOMEMLIMIT_API=200MiB
GOMEMLIMIT_ADMIN=96MiB
GOMEMLIMIT_HUB=540MiB

# ClickHouse memory (P5 3.4 and 6.3), in bytes. Every number below is a column of the table in 6.3, and the
# sizes test of internal/lint adds them up under CH_MAX_SERVER_MEMORY_USAGE: 720 + 80 + 300 MiB of users,
# 192 of caches, 150 for the server and 400 of merges are 1,842 of 1,907 MiB.
# One query of ctrlz_api and both limits of ctrlz_preview: 80 MiB. Spilling to disk starts at half.
CH_QUERY_MAX_MEMORY=83886080
CH_QUERY_SPILL_BYTES=41943040
# Temporary files of spilling queries (disk): one query 512 MiB, all queries of one reader user 2 GiB.
CH_QUERY_TMP_DISK=536870912
CH_USER_TMP_DISK=2147483648
# What all the analytics turns of ctrlz_api may use at once (720 MiB), and its threads per query.
CH_API_USER_MAX_MEMORY=754974720
CH_API_MAX_THREADS=2
# The hub's inserts: one block (200 MiB) and all of its blocks at once (300 MiB).
CH_INGEST_MAX_MEMORY=209715200
CH_INGEST_USER_MAX_MEMORY=314572800
# The mark, index mark and primary index caches: 96 + 64 + 32 MiB.
CH_MARK_CACHE_SIZE=100663296
CH_INDEX_MARK_CACHE_SIZE=67108864
CH_PRIMARY_INDEX_CACHE_SIZE=33554432
# Past this (400 MiB) a merge waits.
CH_MERGES_SOFT_LIMIT=419430400
